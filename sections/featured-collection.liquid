<div class="catalog-intro">
  {% if section.settings.heading != blank %}<h1>{{ section.settings.heading | escape }}</h1>{% endif %}
  {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
  {% if section.settings.collection != blank %}
    <div class="catalog-grid">
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        <article>
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 640 | image_tag: widths: '240, 400, 640', sizes: '(min-width: 800px) 25vw, 50vw', loading: 'lazy' }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
            <h2>{{ product.title | escape }}</h2>
          </a>
          <p>{% if product.price_varies %}{{ 'electronics.from_price' | t }} {% endif %}<bdi>{{ product.price | money_with_currency }}</bdi></p>
        </article>
      {% else %}
        <p>{{ 'electronics.no_products' | t }}</p>
      {% endfor %}
    </div>
    <a href="{{ section.settings.collection.url }}">{{ 'electronics.view_collection' | t }}</a>
  {% else %}
    <p>{{ 'electronics.no_products' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}">{{ 'electronics.browse_products' | t }}</a>
  {% endif %}
</div>
{% stylesheet %}
.catalog-intro { padding-block: 3rem; display: grid; gap: 1.5rem; }
.catalog-intro h1 { font-size: clamp(2rem,5vw,4rem); max-width: 20ch; }
.catalog-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,220px),1fr)); gap:1.5rem; }
.catalog-grid article { min-width:0; }
.catalog-grid img, .catalog-grid svg { aspect-ratio:1; object-fit:contain; width:100%; }
.catalog-grid h2 { font-size:1.1rem; margin-block:.75rem; }
.catalog-grid a { color:inherit; text-decoration:none; }
{% endstylesheet %}
{% schema %}
{"name":"t:general.featured_collection","settings":[{"type":"text","id":"heading","label":"t:general.heading"},{"type":"richtext","id":"text","label":"t:general.text"},{"type":"collection","id":"collection","label":"t:general.collection"},{"type":"range","id":"limit","min":2,"max":12,"step":1,"default":4,"label":"t:labels.product_limit"}],"presets":[{"name":"t:general.featured_collection"}]}
{% endschema %}
